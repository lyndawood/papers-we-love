{
  "name": "papers-we-love-web",
  "version": "1.0.0",
  "description": "Interactive website to browse, search, and read papers from Papers We Love",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "build": "cd frontend && npm run build",
    "start": "node server.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run frontend:dev\"",
    "server:dev": "node --watch server.js",
    "frontend:dev": "cd frontend && npm run dev",
    "parse": "python3 parse_papers.py"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "sqlite3": "^5.1.6",
    "sqlite": "^5.0.1",
    "body-parser": "^1.20.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
